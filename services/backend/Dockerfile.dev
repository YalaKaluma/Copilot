# Development Dockerfile for Backend
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies (including build tools for pygraphviz)
RUN apt-get update && apt-get install -y \
    curl \
    gcc \
    graphviz \
    graphviz-dev \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast Python package management
RUN pip install uv

# Copy shared packages
COPY packages/ /packages/

# Copy application code
COPY services/backend/app/ ./
COPY services/backend/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# Add packages to Python path
ENV PYTHONPATH=/

# Install all dependencies (including dev)
RUN uv sync

RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8080

# Use entrypoint for migrations
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Development command with hot reload (optionally with debugpy)
CMD ["bash", "-c", "if [ \"$DEBUGPY\" = \"1\" ]; then DEBUGPY_PORT=${DEBUGPY_PORT:-5678}; DEBUGPY_WAIT=${DEBUGPY_WAIT:-0}; WAIT_FLAG=\"\"; if [ \"$DEBUGPY_WAIT\" = \"1\" ]; then WAIT_FLAG=\"--wait-for-client\"; fi; exec uv run -- python -m debugpy --listen 0.0.0.0:${DEBUGPY_PORT} ${WAIT_FLAG} -m uvicorn main:app --host 0.0.0.0 --port 8080 --loop asyncio --reload --reload-include app/prompts/**/*.j2; else exec uv run -- python -m uvicorn main:app --host 0.0.0.0 --port 8080 --loop asyncio --reload --reload-include app/prompts/**/*.j2; fi"]
