# Frontend Environment Configuration
# Copy this file to .env.frontend and fill in your values

# === REQUIRED CONFIGURATION ===

# Clerk Authentication (Required)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Backend API URL
# Not needed for local development - Vite proxy handles /api routes
# Set VITE_BACKEND_URL in production deployments, such as Railway.
# Do not include /api; the app appends it automatically.
# VITE_BACKEND_URL=https://your-backend.up.railway.app

# Environment
NODE_ENV=development
# VITE_ENVIRONMENT=prod

# Feature Flags
VITE_DEBUG=true

# Langfuse (optional - trace link in Plan & Execution pane)
# Set VITE_LANGFUSE_PROJECT_URL to show "View in Langfuse" (e.g. https://cloud.langfuse.com or project URL)
VITE_LANGFUSE_PROJECT_URL=
# Set to false to hide the Langfuse trace toggle and link (default: true)
VITE_LANGFUSE_TRACE_ENABLED=true

# Logging
# Levels: debug (default dev), info, warn, error (default prod), silent
VITE_LOG_LEVEL=debug
